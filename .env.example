# Copy to .env and fill in. .env is gitignored; keep it chmod 600.

# https://my-api.plantnet.org/ - plant species & disease identification API
PLANTNET_API_KEY=

# https://console.anthropic.com/ - used to generate care instructions
ANTHROPIC_API_KEY=

# Long random string; the Flutter app sends this as a Bearer token.
API_BEARER_TOKEN=

# SQLite file path (relative to project root, or absolute)
DB_PATH=data/plants.db

# Photo storage directory
PHOTOS_DIR=data/photos

# Vault sync target. Set to "local" during dev to write directly into
# a local vault path (VAULT_LOCAL_PATH). On your-server in production, set
# to the Mac's SSH host (e.g. its Tailscale MagicDNS name) to push over
# rsync/ssh instead.
VAULT_SSH_HOST=local
VAULT_LOCAL_PATH=/path/to/your/ObsidianVault
VAULT_REMOTE_PATH=Documents/Symbiote
